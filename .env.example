# Copy to `.env` and fill in. `packages/shared/src/env.ts` validates these at
# boot and the process refuses to start if anything required is missing.

NODE_ENV=development

# Local infra (docker compose up -d)
DATABASE_URL=postgresql://pipefix:pipefix_dev_pw@localhost:5432/pipefix?schema=public
REDIS_URL=redis://localhost:6379

# App
PORT=3000
LOG_LEVEL=info

# Business timezone — all slot/surge/holiday logic is computed in IST.
BUSINESS_TIMEZONE=Asia/Kolkata
