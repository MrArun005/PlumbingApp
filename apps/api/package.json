{
  "name": "@pipefix/api",
  "version": "0.1.0",
  "private": true,
  "description": "PipeFix backend — NestJS modular monolith",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@pipefix/db": "workspace:*",
    "@pipefix/pricing": "workspace:*",
    "@pipefix/shared": "workspace:*",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc/core": "^1.13.6",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.14",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
